ORACLE_ENV=development
DATABASE_URL=sqlite:///./oracle.db
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
# API credentials: token|tenant-id|role entries separated by semicolons.
# Roles: viewer, operator, admin, ingestor. Generate unique long random tokens.
# Example: ORACLE_API_KEYS=REPLACE_TOKEN|tenant-a|admin;REPLACE_TOKEN_2|tenant-a|operator
ORACLE_API_KEYS=

# Optional AI integration. Outbound data sharing is disabled unless explicitly enabled.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30
AI_DATA_SHARING_ENABLED=false

# Optional OpenTelemetry traces. Leave empty to disable outbound trace export.
OTEL_SERVICE_NAME=oracle-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
